{
  "name": "kite-plugins",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "type-check": "pnpm -r run type-check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "pnpm --parallel -r run dev",
    "pack": "pnpm -r run pack",
    "release": "bash scripts/release.sh",
    "catalog": "node scripts/generate-catalog.mjs",
    "catalog:dev": "node scripts/generate-catalog.mjs --base-url=http://127.0.0.1:18086 && python3 -m http.server 18086 --bind 127.0.0.1 --directory dist/catalog"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "typescript-eslint": "^8.68.0"
  }
}
